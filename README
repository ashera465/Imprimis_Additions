#To clone this repo + branch with its submodules
git clone --recursive -b "Test" https://github.com/ashera465/Imprimis_Additions

#In the workspace root:

  #Install ros dependencies
rosdep install --from-paths src --ignore-src -r -y
colcon build --symlink-install              #Build files w/ symoblic link
source ./install/setup.bash               #Source env vars
ros2 launch ntrip_client ntrip.launch.py  #Launch

#If u want to make a package or smth
ros2 pkg create --build-type ament_python --node-name my_node my_py_pkg --dependencies rclpy

#If u need to delete the colcon built files
rm -rf build/ install/ log/               #Delete build


#Check USB Ports (Linux)
sudo dmesg | grep -E "tty|ACM"  
ls /dev/ttyUSB* /dev/ttyACM*
sudo screen /dev/ttyACM0 38400  #Screen output on USB Port

#All in one (this should work without GPS connected if you have valid credentials for the NTRIP Caster)
colcon build --symlink-install
source ./install/setup.bash
ros2 launch ntrip_client ntrip.launch.py sim:=true show_map:=true
